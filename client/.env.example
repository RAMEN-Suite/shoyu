# -----------------------------------------------------------------------------
# Shoyu client
# -----------------------------------------------------------------------------

# Primary language of the rendered HTML document.
CLIENT_LANG="de"

# Initial browser/tab title rendered in index.html.
CLIENT_TITLE="Shoyu – Graph-based Digital Edition"

# Initial meta description rendered in index.html.
CLIENT_DESCRIPTION="The victor shall write the tale, and the vanquished become its villain."

# Angular base href. Use "/" for root deployments or "/shoyu/" for subpath deployments.
CLIENT_BASE_HREF="/"

# Favicon href rendered in index.html.
CLIENT_FAVICON_HREF="/favicon.ico"
